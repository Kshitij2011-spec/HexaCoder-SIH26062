# ============================================================
# SIH26062 — HexaCoders Environment Configuration Template
# ============================================================
# Copy this file to .env and adjust values for local development.
# NEVER commit .env containing real credentials to Git!

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="HexaCoders - SIH26062"

# Security & Authentication (Replace with secure random keys in local .env)
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-local-dev-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL / Supabase)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hexacoders_polar
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hexacoders_polar

# Supabase Configuration (When using Supabase hosted platform)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Frontend Application Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="HexaCoders Polar Logistics"
VITE_ENVIRONMENT=development
